# ───────────── Nihongo Compass — biến môi trường ─────────────
# Chạy `npm run setup` để tạo file .env.local với giá trị ngẫu nhiên an toàn.

# 1) CHẾ ĐỘ DỮ LIỆU
# Để trống 2 biến Supabase → chế độ "local" (dữ liệu mẫu + file JSON trong /data, tiến độ lưu trong trình duyệt).
# Điền cả hai → chế độ "supabase" (database + đăng nhập thật).
NEXT_PUBLIC_SUPABASE_URL=
# Khóa "anon"/"publishable" của Supabase. Khóa này CÔNG KHAI theo thiết kế, an toàn nhờ Row Level Security.
# TUYỆT ĐỐI KHÔNG đặt service_role key ở đây hay ở bất kỳ biến NEXT_PUBLIC_* nào.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2) ADMIN Ở CHẾ ĐỘ LOCAL (bắt buộc nếu muốn vào /admin khi chưa dùng Supabase)
ADMIN_PASSWORD=
# Chuỗi ngẫu nhiên >= 32 ký tự dùng để ký cookie phiên admin
SESSION_SECRET=

# 3) CHẠY TRÊN ĐIỆN THOẠI QUA WI-FI (chỉ cần khi dùng `npm run dev:lan`)
# Ví dụ: 192.168.1.*  (nhiều giá trị cách nhau bằng dấu phẩy)
ALLOWED_DEV_ORIGINS=

# 4) AI TRONG TƯƠNG LAI — CHỈ SERVER, CHƯA ĐƯỢC SỬ DỤNG BỞI MÃ HIỆN TẠI
# AI_PROVIDER_API_KEY=
# AI_FEATURES_ENABLED=false
