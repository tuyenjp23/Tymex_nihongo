{
  "name": "nihongo-compass",
  "version": "0.1.0",
  "private": true,
  "description": "Nihongo Compass — 日本語学習ラボ: nền tảng học tiếng Nhật cho người Việt",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:images": "node scripts/generate-images.mjs",
    "validate:content": "tsx scripts/validate-content.ts",
    "dev:lan": "next dev -H 0.0.0.0",
    "start:lan": "next start -H 0.0.0.0",
    "build:seed": "node content/src/build-seed.mjs",
    "seed:sql": "node scripts/seed-sql.mjs",
    "test:db": "vitest run tests/unit/db",
    "import:inspect": "tsx scripts/import.ts inspect",
    "import:plan": "tsx scripts/import.ts plan",
    "import:apply": "tsx scripts/import.ts apply",
    "import:resume": "tsx scripts/import.ts resume",
    "import:rollback": "tsx scripts/import.ts rollback",
    "import:backup": "tsx scripts/import.ts backup",
    "import:translate-export": "tsx scripts/import.ts translate-export",
    "import:quality": "tsx scripts/import.ts quality"
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  }
}
